{
    "name": "aventistesting.playwrighttemplate",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "test": "npx tsx libs/utils/parameters/createJSON.ts && npx tsx libs/utils/generator-testcase.ts",
        "test:Testcases": "npx playwright test --headed",
        "test:KVTests": "npx playwright test --config='playwright.kv.config.ts'",
        "test:ui": "npx playwright test --config=playwright.debug.config.ts --ui",
        "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "test:unit:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
        "test:unit:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
        "typecheck": "tsc --noEmit",
        "validate-tags": "npx tsx libs/utils/validate-test-tags.ts",
        "prepare": "husky",
        "azure:sync": "npx tsx libs/utils/azure-test-sync-cli.ts sync",
        "azure:validate": "npx tsx libs/utils/azure-test-sync-cli.ts validate",
        "azure:report": "npx tsx libs/utils/azure-test-sync-cli.ts report",
        "azure:list": "npx tsx libs/utils/azure-test-sync-cli.ts list",
        "azure:known-bugs": "npx tsx libs/utils/azure-test-sync-cli.ts known-bugs",
        "azure:update-comments": "npx tsx libs/utils/azure-test-sync-cli.ts update-comments",
        "azure:create-missing": "npx tsx libs/utils/azure-test-sync-cli.ts create-missing",
        "azure:help": "npx tsx libs/utils/azure-test-sync-cli.ts help",
        "azure:sync-domain": "npx tsx libs/utils/azure-test-sync-cli.ts sync-domain"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@azure/playwright": "^1.1.0",
        "@eslint/js": "^9.39.2",
        "@executeautomation/playwright-mcp-server": "^1.0.12",
        "@faker-js/faker": "^10.3.0",
        "@playwright/test": "^1.56.1",
        "@stylistic/eslint-plugin": "^5.6.1",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.19.35",
        "cross-env": "^10.1.0",
        "dotenv": "^16.4.5",
        "eslint": "^9.39.2",
        "exceljs": "^4.4.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^16.2.7",
        "otpauth": "^9.4.1",
        "string-builder": "^0.1.8",
        "testable-playwright-test": "^0.1.6",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.52.0",
        "xlsx-populate": "^1.21.0"
    },
    "dependencies": {
        "@alex_neo/playwright-azure-reporter": "^1.19.0"
    }
}