# ============================================
# AVENTIS TEST ENVIRONMENT
# ============================================
# Copy this file to .env and set your values
# Available environments: qa, dev, staging, local
BASE_URL=https://qa.aventis.swiss/

# ============================================
# LOCAL DEVELOPMENT (optional)
# ============================================
# For local testing, set these values:
# BASE_URL=https://localhost/
# API_BASE_URL=https://localhost:44315
# Note: SSL certificate errors are ignored in local config

# ============================================
# AZURE DEVOPS & PLAYWRIGHT SERVICE
# ============================================
PLAYWRIGHT_SERVICE_URL=wss://westeurope.api.playwright.microsoft.com/playwrightworkspaces/32cafec9-f8b5-4f7b-a6e2-44306eb163fc/browsers
AZURE_TOKEN=YOUR_TOKEN_HERE
URL=https://diartis.visualstudio.com/Aventis
RUN_TIME_STEP=2

# Keyword Validation Tests
AZURE_DEVOPS_KV_PLAN_ID=181204
AZURE_DEVOPS_KV_SUITE_ID=181205

# Journey Tests
AZURE_DEVOPS_JT_PLAN_ID=183831
AZURE_DEVOPS_JT_SUITE_ID=183879

# Acceptance Tests
AZURE_DEVOPS_AT_PLAN_ID=183595
AZURE_DEVOPS_AT_SUITE_ID=183597

# 0 | 1 | 2 (0 : default, 1 : run time duration, 2: no report )
TESTABLE_API=lvrokxkhuantisfgwcbcdnvfthysbfnqdjkund

# ============================================
# AZURE TEST SYNC CLI (azure-test-sync-cli.ts)
# ============================================
# PAT for ADO REST API (required for create-missing, update-comments)
# Generate at: https://diartis.visualstudio.com/_usersSettings/tokens
# Scopes needed: Work Items (Read & Write), Test Management (Read & Write)
AZURE_DEVOPS_TOKEN=
# Organization URL (default: https://diartis.visualstudio.com)
AZURE_DEVOPS_ORG_URL=https://diartis.visualstudio.com
# Project name (default: Aventis)
AZURE_DEVOPS_PROJECT=Aventis

# ============================================
# TOTP / MFA SECRETS (required for login)
# ============================================
# Each test user environment needs its own TOTP secret for 2FA login.
# Get these from your team lead or Azure Key Vault.
# Without these, login will fail with:
#   "No secret found for username: xxx. Set TOTP_SECRET_XXX environment variable."
TOTP_SECRET_RETSCH=
TOTP_SECRET_RETSCO=
TOTP_SECRET_RETSCE=
TOTP_SECRET_RETSCD=

# ============================================
# STABILITY CONFIGURATION
# ============================================
# Global slowMo for all browser actions (milliseconds)
# Higher values = slower execution = more stable tests
# Recommendation: 300-1000 for stability issues
SLOWMO=500

# Additional stability delay for critical sections (milliseconds)
# This is used by stabilityDelay() method in keywords
# Recommendation: 1000-3000 for problematic applications
STABILITY_DELAY=1500

# Global timeout multiplier (decimal)
# Multiplies all timeouts by this factor
# Recommendation: 1.5-2.0 for slower applications
TIMEOUT_MULTIPLIER=1.5

# Wait after navigation (milliseconds)
# Additional wait time after page navigation
NAVIGATION_STABILITY_WAIT=2000

# Wait after actions (milliseconds)
# Additional wait time after clicks, fills, etc.
ACTION_STABILITY_WAIT=500

# Enable verbose stability logging
STABILITY_VERBOSE_LOGGING=true
